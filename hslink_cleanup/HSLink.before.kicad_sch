(global_label "HSL_TARGET_UART_RX" (shape bidirectional) (at 290.08 160.96 180) (effects (font (size 1.0 1.0)) (justify right)) (uuid "f1a0d085-7285-45be-9ed4-a1ae6d622278"))
(text "HPM5301 REFERENCE DEBUGGER / HSLink-style hardware\nUSB-powered debugger; target remains powered by board supply.\nReference GPIO mapping retained. Firmware compatibility NOT verified." (at 255 65 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "243f9c26-a99a-436b-b034-b252ed8f533b"))
(text "TARGET LINKS R8901..R8905: DEFAULT DNP / OPEN\nFit 0R only with target VCC present. Remove before external J200 probe\nor debugging with target unpowered. NO automatic backfeed isolation.\nSWDIO / SWCLK / NRST / target TX / target RX (top to bottom).\nJ200 and onboard debugger must never drive target simultaneously." (at 255 183 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "60a011b6-5fd4-4784-974e-9c7725f4284f"))
(text "H8001 pin1 = target VCC reference ONLY; no target power injection.\nNo validated ADC voltage sensing or firmware power-off tri-state.\nH8001 other signals remain debugger side of target disconnect links.\nHSL_TARGET_UART_TX = GD32 PD5 USART1_TX AF0 -> probe RX.\nHSL_TARGET_UART_RX = GD32 PD6 USART1_RX AF0 <- probe TX." (at 255 224 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "00a737c6-cbab-4da2-8e86-8619c4b6fd79"))
(text "Reference: HPM 4_DAP + isolated 3_POWER 5V/3.3V block.\nUSB1 / EtherCAT / HPM main-controller circuit intentionally excluded.\nUSB footprint and firmware require validation before PCB fabrication." (at 15 230 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ec117315-547a-421a-a211-9f4d1d818847"))
)