(fp_lib_table (version 7)
(lib (name "VerifiedParts") (type "KiCad") (uri "${KIPRJMOD}/VerifiedParts.pretty") (options "") (descr "Exact MPN models retrieved from HQ catalog"))
(lib (name "GD32F505xx") (type "KiCad") (uri "${KIPRJMOD}/GD32F505xx.pretty") (options "") (descr "Exact HQ GD32F505VGT6 LQFP100 model"))
(lib (name "ProDoc_Board1v1_2026-10-26-import-fps") (type "KiCad") (uri "${KIPRJMOD}/ProDoc_Board1v1_2026-10-26-import-fps.pretty") (options "") (descr "Reference P2 footprint library"))
(lib (name "ProDoc_Boa-easyedapro") (type "KiCad") (uri "${KIPRJMOD}/ProDoc_Board1v1_2026-10-26-import-fps.pretty") (options "") (descr "Reference P2 footprint library"))

(lib (name "ProDoc_IPB-TINY_2026-10-26-import-fps") (type "KiCad") (uri "${KIPRJMOD}/ProDoc_IPB-TINY_2026-10-26-import-fps.pretty") (options "") (descr "HPM debugger reference"))

(lib (name "ProDoc_IPB-easyedapro") (type "KiCad") (uri "${KIPRJMOD}/ProDoc_IPB-TINY_2026-10-26-import-fps.pretty") (options "") (descr "HPM imported footprint alias"))

(lib (name "Interface") (type "KiCad") (uri "${KIPRJMOD}/Interface.pretty") (options "") (descr "Verified standard footprints for LCD and buttons"))
(lib (name "HXTAL") (type "KiCad") (uri "${KIPRJMOD}/HXTAL.pretty") (options "") (descr "HQ part model for Abracon ABM3B; vendor land-pattern visual review pending"))
