	(text "MOTOR 1: independent gate drive, six MOSFETs, phase shunts and bus shunt.\nAll motor signals M1_*. Common DCBUS / 12V / 5V / VCC / AVCC / VREF.\nPGND is common AFTER the dedicated bus shunt; phase-shunt return remains local.\nReference values and footprints require engineering review; no rating verification."
		(exclude_from_sim no)
		(at 15 335 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "87f11344-8639-46a3-8fa3-c1dfecd0d1df")
	)
	(text "VA/VB/VC, COM, IBUS, NTC and auxiliary PWM are retained reference interfaces.\nOnly nets explicitly connected on MCU sheet are MCU functions.\nFD6288Q has no dedicated EN pin: hardware gate-input pulldowns are provided.\nBRKIN requires external fault generation; software must initialize PWM disabled."
		(exclude_from_sim no)
		(at 15 370 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e4aff5ac-57b6-48de-aff5-7abb475b6517")
	)
