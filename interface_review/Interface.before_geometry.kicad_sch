(text "LCD MODULE / 3.3V LOGIC ONLY / WRITE-ONLY SPI0" (at 25.4 20.32 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "40f3152c-5b8a-40e2-abc4-454e234b851e"))
(text "J300 is a board-defined 1x8 2.54mm header, not a module pinout standard." (at 25.4 116.84 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "79d2f685-fc6f-4394-b975-69bec6235f62"))
(text "Use a verified cable adapter. No MISO, SD card, touch or readback support." (at 25.4 120.34 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "42a16ae8-1258-423a-8606-4020602af3a8"))
(text "VCC = board 3.3V; check module current + board regulator thermal budget." (at 25.4 123.84 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3c9cd1cb-9b40-4be0-b4c7-30342f755530"))
(text "Place C300/C301 near J300; select effective bulk capacitance under DC bias." (at 25.4 127.34 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "63e8c8c1-45f0-40ab-abb9-18aaf163b285"))
(text "BL_CTRL is a logic enable/PWM signal ONLY." (at 190.5 116.84 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "62c13204-e26a-4bf7-8d25-4fd68831e99b"))
(text "Not a backlight LED power driver. Module must provide its own driver." (at 190.5 120.34 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "194a31a2-817d-447e-982a-2ac54a5ab7fa"))
(text "R313 holds BL off at reset; verify the module active-high enable polarity." (at 190.5 123.84 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "484ec567-8cb9-4f54-8a37-2d23349c6883"))
